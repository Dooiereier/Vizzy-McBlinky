# Unity-generated cache/build folders - fully regenerable, never commit these.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Build output for this mod - regenerated by Mod Builder.
ModAssetBundles/

# Stock Jundroo ModTools SDK scaffold + generic project-template boilerplate that comes
# with every new mod project (reference assemblies, "_Help_*.txt" stub files, a default
# sample scene, empty part manager stub) - not this mod's own content. Anyone building
# from source regenerates this via Jundroo's own Mod Project Setup tool.
Assets/ModTools/
Assets/ModTools.meta
Assets/Content/
Assets/Content.meta
Assets/Resources/
Assets/Resources.meta
Assets/Scenes/
Assets/Scenes.meta
Assets/_Help_ Getting Started.txt
Assets/_Help_ Getting Started.txt.meta

# IDE project files Unity regenerates on open - the .csproj in particular embeds an
# absolute path to this machine's own Unity Editor install, so committing it would
# break on anyone else's machine.
.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS cruft
.DS_Store
